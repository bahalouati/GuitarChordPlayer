// Windows executable icon and version information.
IDI_ICON1 ICON "@CMAKE_CURRENT_SOURCE_DIR@/resources/app.ico"

1 VERSIONINFO
FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,@APP_BUILD@
PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,@APP_BUILD@
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "Guitar Chord Player"
      VALUE "FileDescription", "Guitar Chord Player"
      VALUE "FileVersion", "@PROJECT_VERSION@.@APP_BUILD@"
      VALUE "InternalName", "GuitarChordPlayer"
      VALUE "OriginalFilename", "GuitarChordPlayer.exe"
      VALUE "ProductName", "Guitar Chord Player"
      VALUE "ProductVersion", "@PROJECT_VERSION@.@APP_BUILD@"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
