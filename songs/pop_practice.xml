<?xml version="1.0" encoding="UTF-8"?>
<!-- An original practice song that shows off the format: different patterns
     per section, a tempo change, a custom chord and split bars. -->
<song title="Pop Practice Song" artist="Guitar Chord Player" bpm="92" beatsPerBar="4">
  <chords>
    <!-- Any chord not in the built-in library can be defined here (low E first). -->
    <chord name="Em7(open)" frets="022033" fingers="012034"/>
  </chords>
  <patterns>
    <pattern name="arpeggio" subdivision="2">B 3 2 3 1 3 2 3</pattern>
    <pattern name="folk" subdivision="2">D - D U - U D U</pattern>
    <pattern name="drive" subdivision="2">>D - D U X U D U</pattern>
    <pattern name="sixteenths" subdivision="4">>D - d u X - u d - u d u X - d u</pattern>
    <pattern name="whole" subdivision="2">>D - - - - - - -</pattern>
  </patterns>
  <sections>
    <section name="Intro" pattern="arpeggio" bpm="84">
      <bars>G | Cadd9 | Em7(open) | D</bars>
    </section>
    <section name="Verse" pattern="folk">
      <bars repeat="2">G | D | Em | C</bars>
    </section>
    <section name="Pre-chorus" pattern="folk">
      <bars>Am | C | D | D:2 Dsus4:2</bars>
    </section>
    <section name="Chorus" pattern="drive" bpm="96">
      <bars repeat="2">C | G | D | Em</bars>
    </section>
    <section name="Bridge" pattern="sixteenths" bpm="88">
      <bars>Am | Am | F | G</bars>
    </section>
    <section name="Outro" pattern="whole" bpm="80">
      <bars>C | D | G | G</bars>
    </section>
  </sections>
  <arrangement>
    <play section="Intro"/>
    <play section="Verse"/>
    <play section="Pre-chorus"/>
    <play section="Chorus"/>
    <play section="Verse"/>
    <play section="Pre-chorus"/>
    <play section="Chorus" repeat="2"/>
    <play section="Bridge"/>
    <play section="Chorus"/>
    <play section="Outro"/>
  </arrangement>
</song>
